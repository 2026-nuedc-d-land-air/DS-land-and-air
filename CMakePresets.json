            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LIDAR_CAR_MAIN_SOURCE": "${sourceDir}/Src/main_gray_tracking_test.c"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "hidden": true,
            "configurePreset": "default"
        },
                {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
