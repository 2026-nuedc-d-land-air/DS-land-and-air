            "configurePreset": "PwmGyroSweepDebug"
        },
        {
            "name": "FourWheelTb6612Debug",
            "configurePreset": "FourWheelTb6612Debug"
        },
        {
            "name": "FrontTb6612DirectTestDebug",
            "configurePreset": "FrontTb6612DirectTestDebug"
        },
        {
            "name": "GrayTrackingDebug",
            "configurePreset": "GrayTrackingDebug"
        }
    ]
